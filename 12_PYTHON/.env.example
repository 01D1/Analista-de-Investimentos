# ─────────────────────────────────────────────────────────────
# Intelligence System — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Ambiente: development | production
ENV=development

# ── Claude API ────────────────────────────────────────────────
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-COLE_AQUI

# ── Telegram ──────────────────────────────────────────────────
# 1. Abra o Telegram → procure @BotFather → /newbot → copie o TOKEN
# 2. Chat ID: crie grupo, adicione o bot, acesse:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:COLE_AQUI
TELEGRAM_CHAT_ID=-100COLE_AQUI

# ── Supabase (opcional — Fase 6) ──────────────────────────────
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=eyJCOLE_AQUI
