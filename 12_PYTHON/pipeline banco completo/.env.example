# Pipeline de Valuation Bancário — variáveis de ambiente opcionais
# Copie para .env e preencha

# Ticker padrão
TICKER_B3=BBDC4
NOME_EMPRESA=Bradesco
CODIGO_CVM=906

# Cotações manuais (sobrescreve yfinance)
COTACAO_ON=0
COTACAO_PN=0

# Ações emitidas (em mil unidades, ex-treasury)
ACOES_ON=5294212
ACOES_PN=5279802

# Premissas de valuation
BETA=0.85
G_PERPETUIDADE=0.070
BASILEIA_ALVO=0.135
PAYOUT=0.45

# ── Alertas Telegram (modules/alerts.py) ─────────────────────────────────────
# Obtenha o token em https://t.me/BotFather
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Condições de disparo de alerta (valores padrão abaixo)
ALERTA_UPSIDE_MIN=0.25          # upside mínimo para alertar (mesmo sem BUY)
ALERTA_SCORE_MIN=60             # score mínimo combinado com upside_min
ALERTA_DELTA_SCORE=15           # variação de score entre runs para alertar
ALERTA_COOLDOWN_HORAS=12        # horas entre alertas iguais (anti-spam)
