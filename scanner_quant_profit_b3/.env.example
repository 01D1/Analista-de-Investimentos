# ═══════════════════════════════════════════════════════════════════════════
# Environment Variables — Credential Template
# ═══════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite .env ao repositório — já está no .gitignore.
#
# Variáveis obrigatórias para funcionamento do pipeline:
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM ────────────────────────────────────────────────────────────────
# Chave da API Anthropic (Claude). Obrigatória para o Intelligence Layer.
# Formato: sk-ant-api03-...
ANTHROPIC_API_KEY=

# ── Telegram Notifications ──────────────────────────────────────────────────
# Token do bot Telegram (obtido via @BotFather no Telegram).
TELEGRAM_BOT_TOKEN=

# ID do chat para envio de alertas (número inteiro, obtido via @userinfobot).
TELEGRAM_CHAT_ID=

# ── News Hunter ─────────────────────────────────────────────────────────────
# Caminho para o diretório do news_hunter (12_PYTHON/news_hunter/).
# Usado pelo news_hunter_connector.py para localizar banco.db.
NEWS_HUNTER_PATH=../12_PYTHON/news_hunter

# ── Database ────────────────────────────────────────────────────────────────
# Caminho para o banco de dados do scanner_quant.
# Padrão: data/database/scanner_quant.db
SCANNER_DB_PATH=data/database/scanner_quant.db

# ── Logging ─────────────────────────────────────────────────────────────────
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Optional: OpenAI (para funcionalidades futuras de embeddings/TCC) ────────
# Formato: sk-...
OPENAI_API_KEY=

# ── Optional: Valuation Pipeline Bridge ────────────────────────────────────
# Caminho para o diretório de outputs do pipeline de valuation (12_PYTHON/).
# Usado como referência para auditoria de valuation, não para consumo direto.
VALUATION_OUTPUTS=../12_PYTHON/pipeline_outputs

# ── Optional: PDF Generation ────────────────────────────────────────────────
# Para delivery/PDF reports. Adicionar weasyprint ou reportlab ao requirements.txt
# WEASYPRINT_PATH=/usr/local/bin/weasyprint